# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 项目本地产物：训练、模型、基座、MLflow、评测、审计、暂存与重建不入 Git
# 若将来需放行某子目录，须把该项改为 /xxx/* 并追加 !/xxx/sub/ 三段式（父目录被排除时 ! 失效）
# 不带尾斜杠：`/xxx/` 只匹配目录，P2 物理搬迁前这些目录尚不存在，git check-ignore 判不出来（守卫 T6 依赖此语义）
/trains
/base-models
/mlflow
/evaluations
/audits
/data-staging
/data-rebuild

# video files
*.mp4
*.mov
# data 下支持的其他视频格式及大小写变体；标注、划分与 ROI 记录入 Git
/data/**/*.[mM][pP]4
/data/**/*.[mM][oO][vV]
/data/**/*.[mM][kK][vV]
/data/**/*.[aA][vV][iI]
/data/**/*.[mM]4[vV]
/data/**/*.[wW][eE][bB][mM]
/data/roi/.roi.lock

# 本地模型权重
models/*

# LLaMA-Factory 训练输出；只保留目录说明文件
LlamaFactory/saves/*
!LlamaFactory/saves/minicpmv4_5/
LlamaFactory/saves/minicpmv4_5/*
!LlamaFactory/saves/minicpmv4_5/lora/
LlamaFactory/saves/minicpmv4_5/lora/*
!LlamaFactory/saves/minicpmv4_5/lora/README.md

# 训练流水线运行日志与 PID/状态文件（保留在训练机，只提交说明）
/finetune/run_logs/*
!/finetune/run_logs/README.md

# 诊断与 Prompt Sweep 生成产物
/finetune/results/experiments/diagnostics/
/finetune/results/experiments/prompt_sweep/

# 评测逐样本记录与一次性 smoke 输出只保留在训练机
/finetune/results/**/evaluation_records.jsonl
/finetune/results/**/four_bit*_smoke*/
/finetune/results/**/runtime_failures.csv
/finetune/results/**/*.restricted.json

# cache 文件
.cache/

# macOS system files
.DS_Store

# pytest cache
.pytest_cache/

.agents/skills/

# API key file
agent/.env

# wandb outputs
finetune/wandb/

# UV Python version pin
.python-version

# Apple Double files (macOS resource forks)
._*

# macOS Spotlight index
.Spotlight-V100

# macOS Trash
.Trashes

# Codex/Drive 本地上传缓存
/.tmp.driveupload/
/.tmp.drivedownload/

# 活 store 已归位到 <项目>/store（迁移完成）：仅放行 Prompt 等小体积 records，其余媒体与权重忽略。
# 注意：本块必须位于所有全局扩展名规则（如 *.mp4、*.mov）之后，后匹配者胜。
/store/*
!/store/records
/store/records/*
!/store/records/prompts
