# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Project-local active V4.1 data, models, logs, and run outputs
/workspace/

# video files
*.mp4
*.mov

# 本地模型权重
models/*

# LLaMA-Factory 训练输出；只保留目录说明文件
LlamaFactory/saves/*
!LlamaFactory/saves/minicpmv4_5/
LlamaFactory/saves/minicpmv4_5/*
!LlamaFactory/saves/minicpmv4_5/lora/
LlamaFactory/saves/minicpmv4_5/lora/*
!LlamaFactory/saves/minicpmv4_5/lora/README.md

# 训练流水线运行日志与 PID/状态文件（保留在训练机，只提交说明）
/finetune/run_logs/*
!/finetune/run_logs/README.md

# 诊断与 Prompt Sweep 生成产物
/finetune/results/experiments/diagnostics/
/finetune/results/experiments/prompt_sweep/

# 评测逐样本记录与一次性 smoke 输出只保留在训练机
/finetune/results/**/evaluation_records.jsonl
/finetune/results/**/four_bit*_smoke*/
/finetune/results/**/runtime_failures.csv
/finetune/results/**/*.restricted.json

# dependency lock files (not cross-platform)
uv.lock

# cache 文件
.cache/

# macOS system files
.DS_Store

# pytest cache
.pytest_cache/

# Data pipeline artifacts (numbered outputs, ignored; 01_videos and 02_annotations are not ignored)
/data/03_subvideos/
/data/03_roi_videos/
/data/03_subvideos_roi/
/data/04_frames/
/data/04_frames_roi/
/data/08_runtime/
data/08_incremental_review

.agents/skills/

