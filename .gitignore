# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# video files
*.mp4
*.mov

# 本地模型权重（统一放在 models/ 下，由 models/README.md 说明）
models/*
!models/README.md

# LLaMA-Factory 训练输出
LlamaFactory/saves/

# 验证脚本输出
finetune/validation/results/

# dependency lock files (not cross-platform)
uv.lock

# cache 文件
.cache/

# macOS system files
.DS_Store

# pytest cache
.pytest_cache/

# Data pipeline artifacts (numbered outputs, ignored; 01_videos and 02_annotations are not ignored)
/data/03_subvideos/
/data/04_frames/
/data/06_merged/
/data/07_metadata/*
!/data/07_metadata/
!/data/07_metadata/video_meta.json
/data/08_runtime/

.agents/skills/

# API key file
agent/.env

# wandb outputs
finetune/wandb/

# UV Python version pin
.python-version

# Apple Double files (macOS resource forks)
._*

# macOS Spotlight index
.Spotlight-V100

# macOS Trash
.Trashes

# 人工审核数据
data/08_review/
data/07_metadata/tail_contamination_audit.jsonl

